# Переменные окружения сайта (Django, python/savdex/settings.py).
# Файл сам Django не читает: значения задаются в окружении — на Render
# в панели (Environment), локально — export или direnv.

APP_NAME=SAVDEX
# production или staging на сервере; иначе включается режим отладки
APP_ENV=local
# Ключ шифрования куки сессии и подписей: base64:<32 случайных байта>,
# например "base64:$(openssl rand -base64 32)". Сменить — значит
# разлогинить всех; прежний ключ можно оставить в APP_PREVIOUS_KEYS
APP_KEY=
APP_PREVIOUS_KEYS=
APP_URL=http://localhost:8000

BCRYPT_ROUNDS=12
LOG_LEVEL=info
BUSINESS_TIMEZONE=Asia/Tashkent

# База — PostgreSQL. DJANGO_DATABASE_URL — роль сайта (права только на
# нужное), DB_URL — владелец базы: им скрипт запуска создаёт схему и
# справочники (docker/render-entrypoint.sh)
DB_CONNECTION=pgsql
DJANGO_DATABASE_URL=postgres://savdex_django:@127.0.0.1:5432/savdex
DB_URL=postgres://savdex:@127.0.0.1:5432/savdex

SESSION_DRIVER=database
SESSION_LIFETIME=120

# file — кэш в storage/framework/cache (курс ЦБ, ограничение частоты)
CACHE_STORE=file

# Почта: log — письма в storage/logs; smtp — настоящая отправка
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="SAVDEX"

# Машинный перевод текстов на языки площадки (manage.py translate)
MACHINE_TRANSLATION_ENABLED=true

# ── Платёжный провайдер Uzum ─────────────────────────────────────────
# ENABLED открывает приём колбэков (Merchant API и Checkout);
# CHECKOUT_ENABLED дополнительно оживляет кнопку «Оплатить» с уводом
# на платёжную страницу Uzum Checkout. Пока оба false — оплата идёт
# по счёту с ручным подтверждением. Ключи выдаёт Uzum; в репозитории
# они пустые и задаются только в окружении сервера.
PAYMENTS_UZUM_ENABLED=false
PAYMENTS_UZUM_CHECKOUT_ENABLED=false
PAYMENTS_UZUM_SANDBOX=true
# Адрес API Uzum Checkout (тестовый или боевой контур) — выдаёт менеджер Uzum
PAYMENTS_UZUM_BASE_URL=
PAYMENTS_UZUM_MERCHANT_ID=
PAYMENTS_UZUM_SERVICE_ID=
# Заголовок X-Terminal-Id исходящих запросов Checkout
PAYMENTS_UZUM_TERMINAL_ID=
# Заголовок X-API-Key исходящих запросов Checkout
PAYMENTS_UZUM_SECRET_KEY=
PAYMENTS_UZUM_WEBHOOK_SECRET=
# Basic auth входящих вызовов Merchant API (согласуется с Uzum отдельно)
PAYMENTS_UZUM_CALLBACK_LOGIN=
PAYMENTS_UZUM_CALLBACK_PASSWORD=
# Исходящий прокси со статическим IP для белого списка Uzum: http://логин:пароль@хост:порт
PAYMENTS_UZUM_PROXY=
# Автофискализация: ИКПУ услуги, код упаковки, ставка НДС, ИНН продавца (пустой SPIC — корзина не передаётся)
PAYMENTS_UZUM_SPIC=
PAYMENTS_UZUM_PACKAGE_CODE=
PAYMENTS_UZUM_VAT_PERCENT=12
PAYMENTS_UZUM_TIN=
PAYMENTS_UZUM_RETURN_URL=
PAYMENTS_UZUM_CALLBACK_IPS=

# ── Ссылка на смену пароля в мессенджеры ─────────────────────
# Пока пусто — на форме «Забыли пароль?» остаётся одна почта.
#
# Telegram: бот заводится в @BotFather за минуту, токен он и выдаёт.
# TELEGRAM_BOT_USERNAME — имя бота без «@».
# TELEGRAM_WEBHOOK_SECRET — любая случайная строка (8–64 знака,
# латиница, цифры, «-» и «_»): она входит в адрес, на который
# Telegram шлёт сообщения. После задания переменных адрес сообщается
# Telegram один раз, командой на сервере:
#   python/.venv/bin/python python/manage.py telegram_webhook
# Она подставит токен и секрет сама; «--info» покажет, что Telegram
# знает о боте сейчас, «--delete» снимет адрес.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business (Meta Cloud API): нужен бизнес-аккаунт Meta,
# номер отправителя и утверждённый шаблон категории «Аутентификация»
# с одной переменной — в неё подставляется ссылка.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=password_reset
WHATSAPP_API_VERSION=v21.0

# Домен мини-сайтов компаний. Пусто — сайты на самой площадке: /s/acme.
# Задан (savdex.site) — поддомены acme.savdex.site. Локально: site.localhost
MICROSITE_DOMAIN=
